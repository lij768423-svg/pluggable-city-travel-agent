# OpenAI-compatible API. See the repository README for configuration.
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3.1-Flash-Preview
LLM_API_KEY=
# MiniMax 思考模式：disabled | adaptive
LLM_THINKING=adaptive
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT=12
TYPESAFE_PROXY_URL=
# 高德 Web服务 key：排程与校验用的真实路线（步行/驾车/公交）。留空则退回估算模型
AMAP_WEB_KEY=
# 高德 Web端（JS API）key 与安全密钥：前端地图。安全密钥只在后端 /_AMapService 代理中使用
AMAP_JS_KEY=
AMAP_JS_SECURITY=
